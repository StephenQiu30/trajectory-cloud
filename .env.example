# ==============================================================================
# Trajectory Cloud - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and fill in your actual credentials.
# NEVER commit the actual .env file to version control.

# Common Configuration
PROJECT_NAME=trajectory
PROJECT_VERSION=1.0.0
TZ=Asia/Shanghai

# Shared Credentials
DEFAULT_PASSWORD=your_secure_password_here

# ------------------------------------------------------------------------------
# MySQL Configuration
# ------------------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=root_password
MYSQL_DATABASE=trajectory_cloud
MYSQL_USER=user
MYSQL_PASSWORD=user_password
MYSQL_HOST=mysql
MYSQL_PORT_EXTERNAL=13306

# ------------------------------------------------------------------------------
# Redis Configuration
# ------------------------------------------------------------------------------
REDIS_PORT_EXTERNAL=16379

# ------------------------------------------------------------------------------
# Nacos Configuration
# ------------------------------------------------------------------------------
NACOS_PORT_EXTERNAL_CONSOLE=8840
NACOS_PORT_EXTERNAL_8848=8848
# Auth token (Must be a 32-character base64 encoded string for Nacos 2.x+)
NACOS_AUTH_TOKEN=secret_token_at_least_32_characters_long

# ------------------------------------------------------------------------------
# RabbitMQ Configuration
# ------------------------------------------------------------------------------
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_PORT_EXTERNAL_AMQP=5672
RABBITMQ_PORT_EXTERNAL_MGMT=15672

# ------------------------------------------------------------------------------
# MinIO Configuration
# ------------------------------------------------------------------------------
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=minio_password
MINIO_PORT_EXTERNAL_API=9000
MINIO_PORT_EXTERNAL_CONSOLE=9001

# ------------------------------------------------------------------------------
# Elasticsearch & Kibana Configuration
# ------------------------------------------------------------------------------
ES_VERSION=9.3.0
ES_CONTAINER_NAME=trajectory-elasticsearch
ES_PASSWORD=es_password
ES_PORT_EXTERNAL=9200
ES_JAVA_OPTS="-Xms1g -Xmx1g"

KIBANA_VERSION=9.3.0
KIBANA_CONTAINER_NAME=trajectory-kibana
KIBANA_PASSWORD=kibana_password
KIBANA_PORT_EXTERNAL=5601
KIBANA_ENCRYPTION_KEY=encryption_key_at_least_32_characters

LOGSTASH_VERSION=9.3.0
LOGSTASH_CONTAINER_NAME=trajectory-logstash
LOGSTASH_PORT_EXTERNAL=5044
LOGSTASH_JAVA_OPTS="-Xms512m -Xmx512m"
