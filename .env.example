# ==============================================================================
# Trajectory Cloud - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and fill in your actual credentials.
# NEVER commit the actual .env file to version control.

# Common Configuration
PROJECT_NAME=trajectory
PROJECT_VERSION=1.0.0
TZ=Asia/Shanghai

# Shared Credentials
DEFAULT_PASSWORD=your_secure_password_here

# ------------------------------------------------------------------------------
# MySQL Configuration
# ------------------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=root_password
MYSQL_DATABASE=trajectory_cloud
MYSQL_USER=user
MYSQL_PASSWORD=user_password
MYSQL_HOST=mysql
MYSQL_PORT_EXTERNAL=13306

# ------------------------------------------------------------------------------
# Redis Configuration
# ------------------------------------------------------------------------------
REDIS_PORT_EXTERNAL=16379

# ------------------------------------------------------------------------------
# Nacos Configuration
# ------------------------------------------------------------------------------
NACOS_PORT_EXTERNAL_CONSOLE=8840
NACOS_PORT_EXTERNAL_8848=8848
NACOS_USER=nacos
NACOS_PASSWORD=your_nacos_password
# Auth token for Nacos security (If applicable)

# ------------------------------------------------------------------------------
# RabbitMQ Configuration
# ------------------------------------------------------------------------------
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_PORT_EXTERNAL_AMQP=5672
RABBITMQ_PORT_EXTERNAL_MGMT=15672

# ------------------------------------------------------------------------------
# MinIO Configuration
# ------------------------------------------------------------------------------
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=minio_password
MINIO_PORT_EXTERNAL_API=9000
MINIO_PORT_EXTERNAL_CONSOLE=9001

# ------------------------------------------------------------------------------
# Service Ports
# ------------------------------------------------------------------------------
GATEWAY_PORT_EXTERNAL=8080
USER_SERVICE_PORT_EXTERNAL=8081
NOTIFICATION_SERVICE_PORT_EXTERNAL=8082
FILE_SERVICE_PORT_EXTERNAL=8083
LOG_SERVICE_PORT_EXTERNAL=8084
MAIL_SERVICE_PORT_EXTERNAL=8085
AI_SERVICE_PORT_EXTERNAL=8086
